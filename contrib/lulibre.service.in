# lulibre's part in starting the calibre content server: before it starts,
# the changes calibre makes only while it is stopped (a new custom column)
# are done, so that saying "not now" to restarting it leaves them for the
# next start. It does nothing when nothing waits.
#
# Install it beside the server's unit, and name that unit below (here
# calibre-server.service) if yours is called otherwise:
#   cp @DATADIR@/lulibre/systemd/lulibre.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable lulibre.service
[Unit]
Description=lulibre: calibre changes that wait for the content server to be stopped
Before=calibre-server.service

[Service]
Type=oneshot
ExecStart=@BINDIR@/lulibre offline
# A oneshot unit has no start timeout of its own, and the server waits for
# this one: if lulibre never ended (a script of init.lua's leaving a timer
# running, say), the server would never start. Writing every book's opf
# file the first time can take minutes; this is far beyond that.
TimeoutStartSec=30min

[Install]
WantedBy=calibre-server.service
